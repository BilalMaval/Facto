# Template only — no real values. Copy the vars you need into
# .env.development.local (loaded by `next dev`) or .env.production.local
# (loaded by `next build`/`next start`). See src/lib/supabase/envGuard.ts for
# why these two are kept as separate files instead of one shared .env.local.

# Supabase project connection (anon key only — never the service role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 (S3-compatible) — file storage for worker photos and payment
# proofs, split by key prefix within this one bucket (worker-photos/...,
# payment-proofs/...), not by separate buckets. Create an API token scoped
# to just this bucket, under Cloudflare dashboard -> R2 -> Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
