{
  "name": "salary-slip-saas-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web --",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web --",
    "lint": "npm run lint --workspace=apps/web --",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test:payroll": "tsx scripts/contract-test-payroll.ts"
  },
  "dependencies": {
    "@facto/payroll-core": "*",
    "@supabase/supabase-js": "^2.110.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
