# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — unrooted (no leading slash) so these match at any depth,
# covering apps/web/node_modules, packages/*/node_modules, apps/web/.next,
# etc. uniformly across the monorepo instead of enumerating every path.
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI local cache
supabase/.temp

# local Claude Code settings
.claude/settings.local.json
